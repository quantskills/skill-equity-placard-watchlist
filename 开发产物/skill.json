{
  "name": "skill-equity-placard-watchlist",
  "version": "1.0.0",
  "build_id": "17",
  "type": "build",
  "category": "monitor+event",
  "description": "举牌行为监控：从十大股东快照重建持股比例上穿 5%/10%/15%/20%/25%/30% 的权益变动事件，含举牌梯度、意图倾向、6 个月锁定期与逼近观察名单；剔除通道账户与股本稀释造成的假举牌。可被复盘 agent 或事件驱动 Alpha 调用。",
  "data_source": "PandaData (panda_data>=0.0.9) — get_top_holders（stock_type=total 口径）",
  "spec_note": "任务清单点名的 get_stock_equity_placard 在 PandaData 最新接口文档（187 方法）中不存在，故由十大股东快照重建；由此产生「报告期快照口径、非实时播报」的根本限制。",
  "entrypoints": {
    "run": "scripts/build.py:run",
    "validate_input": "scripts/build.py:validate_input",
    "maintain_daily": "scripts/build.py:maintain_daily",
    "backfill": "scripts/build.py:backfill",
    "save_parquet": "scripts/build.py:save_parquet",
    "to_standard_output": "scripts/build.py:to_standard_output",
    "detect_events": "scripts/placard.py:detect_events",
    "infer_share_change": "scripts/placard.py:infer_share_change",
    "approaching_watchlist": "scripts/placard.py:approaching_watchlist",
    "plain_text": "scripts/placard.py:plain_text",
    "normalize_holders": "scripts/datasource.py:normalize_holders",
    "classify_holder": "scripts/datasource.py:classify_holder",
    "render_markdown": "scripts/render.py:render_markdown",
    "render_html": "scripts/render.py:render_html",
    "test": "scripts/test.py"
  },
  "inputs": [
    "{\"symbols\":[...],\"start\":\"YYYYMMDD\",\"end\":\"YYYYMMDD\"}",
    "{\"mode\":\"scan\",\"start\":\"YYYYMMDD\",\"end\":\"YYYYMMDD\"}",
    "{\"panel\":<DataFrame>}"
  ],
  "outputs": {
    "format": "pandas.DataFrame (BUILD §11 面板)",
    "result_types": ["placard_event", "channel_flow", "approaching", "placard_summary"],
    "primary_key": ["trade_date", "build_id", "target_id", "result_type", "holder_name", "as_of_date"],
    "audit_fields": ["base_pct", "active_delta", "share_change_k", "change_kind"]
  },
  "thresholds": [5, 10, 15, 20, 25, 30],
  "callable_by_alpha": true,
  "produces_parquet": true,
  "offline_testable": true,
  "pit_basis": "trade_date = 公告日（date），as_of_date = 报告期（end_date）",
  "known_limitations": [
    "报告期快照口径，报告期之间发生并回撤的举牌看不到，非实时播报",
    "一致行动人无法合并（数据源无该字段）",
    "仅十大股东，榜外存在理论盲区",
    "intent 为倾向判断而非定论",
    "股本变动校正需 ≥3 个股东"
  ],
  "disclaimer": "仅量化研究与教育示例，不构成投资建议，不承诺收益；举牌事件不代表标的会涨，核对以官方权益变动报告书为准。"
}
